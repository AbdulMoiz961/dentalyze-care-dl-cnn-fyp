# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dentalyze.db

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model Settings
MODEL_PATH=./trained_models/dentex_frcnn_best.pth
USE_CNN_MODEL=true

# Gemini Fallback (used when CNN model is unavailable or USE_CNN_MODEL=false)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash-preview-04-17

# Server Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
